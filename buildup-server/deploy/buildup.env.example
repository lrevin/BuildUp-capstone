# 운영 서버 환경 변수 예시 → /opt/buildup/buildup.env 로 복사해서 값을 채운다
# (진짜 비밀번호를 넣은 파일은 git에 올리지 말 것. chmod 600 buildup.env)
DB_URL=jdbc:mysql://127.0.0.1:3306/buildup?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=buildup
DB_PASSWORD=여기에_DB_비밀번호
# 웹 대시보드 주소(쉼표로 여러 개)
CORS_ORIGINS=https://dashboard.example.com
# 사진·첨부 파일 저장 폴더(백업 대상)
UPLOAD_DIR=/opt/buildup/uploads
# 휴대폰 알림 키 파일(Firebase 서비스 계정, 권한 600). 없으면 알림 없이 동작
FIREBASE_KEY=/opt/buildup/firebase-key.json
